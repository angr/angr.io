        "streamHtml": "func main.main() {\n    v0 := 0\n    v1 := 0\n    v2 := 0\n    v3 := 0\n    v4 := 0\n    v10 := &quot;Username: \\nPassword: \\nbad addressfile existsbroken pipebad messageassistQueuenetpollInitreflectOffsglobalAllocmSpanManualstart traceclobberfreegccheckmarkscheddetailunspecified&quot;\n    syscall.RawSyscall(1, 1, &quot;Username: \\n&quot;, 11)\n    v9 := &amp;v0\n    syscall.RawSyscall(0, 0, &amp;v0, 8)\n    v8 := &amp;v4\n    syscall.RawSyscall(0, 0, &amp;v4, 1)\n    v7 := &quot;Password: \\nbad addressfile existsbroken pipebad messageassistQueuenetpollInitreflectOffsglobalAllocmSpanManualstart traceclobberfreegccheckmarkscheddetailunspecified&quot;\n    syscall.RawSyscall(1, 1, &quot;Password: \\n&quot;, 11)\n    v6 := &amp;v2\n    syscall.RawSyscall(0, 0, &amp;v2, 8)\n    v5 := &amp;v4\n    syscall.RawSyscall(0, 0, &amp;v4, 1)\n    ok, v13 := main.authenticate(&amp;v0, 9, 9, &amp;v2, 8, 9)\n    if !ok {\n        main.rejected()\n        return\n    }\n    main.accepted()\n    return\n}",
        "out": null
