[9.4998, "o", "\u001b[94mfn\u001b[0m\u001b[90m \u001b[0m\u001b[92mfauxware\u001b[0m::authenticate()\u001b[90m \u001b[0m->\u001b[90m \u001b[0m\u001b[4;92mu0\u001b[0m\u001b[90m \u001b[0m{\r\n\u001b[90m    \u001b[0m\u001b[94mlet\u001b[0m\u001b[90m \u001b[0mv0:\u001b[90m \u001b[0m\u001b[96mu8\u001b[0m;\u001b[90m  \u001b[0m\u001b[2m// [bp-0x51]\u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[94mlet\u001b[0m\u001b[90m \u001b[0mv1:\u001b[90m \u001b[0m\u001b[96mu8\u001b[0m;\u001b[90m  \u001b[0m\u001b[2m// [bp-0x50]\u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[94mlet\u001b[0m\u001b[90m \u001b[0mv2:\u001b[90m \u001b[0m\u001b[96mu8\u001b[0m;\u001b[90m  \u001b[0m\u001b[2m// [bp-0x48]\u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[94mlet\u001b[0m\u001b[90m \u001b[0mv3:\u001b[90m \u001b[0m\u001b[96mResult\u001b[0m<struct4,\u001b[90m \u001b[0mstruct8>;\u001b[90m  \u001b[0m\u001b[2m// [bp-0x30]\u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[94mlet\u001b[0m\u001b[90m \u001b[0mv4:\u001b[90m \u001b[0m\u001b[4;92mstruct4\u001b[0m;\u001b[90m  \u001b[0m\u001b[2m// [bp-0x2c]\u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[94mlet\u001b[0m\u001b[90m \u001b[0mv5:\u001b[90m \u001b[0m\u001b[4;92mstruct4\u001b[0m;\u001b[90m  \u001b[0m\u001b[2m// [bp-0x1c]\u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[94mlet\u001b[0m\u001b[90m \u001b[0mv6:\u001b[90m \u001b[0m\u001b[4;92mstruct16\u001b[0m;\u001b[90m  \u001b[0m\u001b[2m// [bp-0x18]\u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[94mlet\u001b[0m\u001b[90m \u001b[0mv7:\u001b[90m \u001b[0m\u001b[94m&\u001b[0m\u001b[4;92mst_40a840_0\u001b[0m;\u001b[90m  \u001b[0m\u001b[2m// [bp-0x8]\u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[94mlet\u001b[0m\u001b[90m \u001b[0mv9:\u001b[90m \u001b[0m\u001b[96mu64\u001b[0m;\u001b[90m  \u001b[0m\u001b[2m// rdi\u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[94mlet\u001b[0m\u001b[90m \u001b[0mv11:\u001b[90m \u001b[0m\u001b[96mu64\u001b[0m;\u001b[90m  \u001b[0m\u001b[2m// rdx\u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[94mlet\u001b[0m\u001b[90m \u001b[0mv12:\u001b[90m \u001b[0m\u001b[4;92mstruct16\u001b[0m;\u001b[90m  \u001b[0m\u001b[2m// rax:rdx\u001b[0m\r\n\r\n\u001b[90m    \u001b[0m\u001b[94mif\u001b[0m\u001b[90m \u001b[0m<&[\u001b[96mu8\u001b[0m;\u001b[90m \u001b[0m\u001b[94m8\u001b[0m]\u001b[90m \u001b[0m\u001b[94mas\u001b[0m\u001b[90m \u001b[0mcore::cmp::\u001b[96mPartialEq\u001b[0m>::eq(&rsi,\u001b[90m \u001b[0m\u001b[33m\"\u001b[0m\u001b[33m\"\u001b[0m)\u001b[90m \u001b[0m\u001b[94mas\u001b[0m\u001b[90m \u001b[0m\u001b[96mchar\u001b[0m\u001b[90m \u001b[0m{\r\n\u001b[90m        \u001b[0m\u001b[94mreturn\u001b[0m;\r\n\u001b[90m    \u001b[0m}\r\n\u001b[90m    \u001b[0mmemset(&v1,\u001b[90m \u001b[0m\u001b[94m0\u001b[0m,\u001b[90m \u001b[0m\u001b[94m8\u001b[0m);\r\n\u001b[90m    \u001b[0m<alloc::string::\u001b[96mString\u001b[0m>::from_utf8_lossy(&v2,\u001b[90m \u001b[0mv9,\u001b[90m \u001b[0m\u001b[94m8\u001b[0m);\r\n\u001b[90m    \u001b[0mv12\u001b[90m \u001b[0m=\u001b[90m \u001b[0m<\u001b[96mstr\u001b[0m>::trim_end_matches::<\u001b[96mchar\u001b[0m>(&v2,\u001b[90m \u001b[0m\u001b[94m0\u001b[0m,\u001b[90m \u001b[0m\u001b[94m0\u001b[0m);\r\n\u001b[90m    \u001b[0mv3\u001b[90m \u001b[0m=\u001b[90m \u001b[0m<std::fs::File>::open::<&\u001b[96mstr\u001b[0m>(v12\u001b[90m \u001b[0m\u001b[94mas\u001b[0m\u001b[90m \u001b[0m\u001b[96mu64\u001b[0m,\u001b[90m \u001b[0m(v12\u001b[90m \u001b[0m>>\u001b[90m \u001b[0m\u001b[94m64\u001b[0m)\u001b[90m \u001b[0m\u001b[94mas\u001b[0m\u001b[90m \u001b[0m\u001b[96mu64\u001b[0m);\r\n\u001b[90m    \u001b[0m\u001b[94mif\u001b[0m\u001b[90m \u001b[0m\u001b[94mlet\u001b[0m\u001b[90m \u001b[0m\u001b[96mOk\u001b[0m(v5)\u001b[90m \u001b[0m=\u001b[90m \u001b[0mv3\u001b[90m \u001b[0m{\r\n\u001b[90m        \u001b[0mv6\u001b[90m \u001b[0m=\u001b[90m \u001b[0mstruct16\u001b[90m \u001b[0m{\r\n\u001b[90m            \u001b[0mfield_0:\u001b[90m \u001b[0m<std::sys::fs::unix::File>::read(&v5,\u001b[90m \u001b[0m&v1,\u001b[90m \u001b[0m\u001b[94m8\u001b[0m)\u001b[90m \u001b[0m\u001b[94mas\u001b[0m\u001b[90m \u00