[9.2765, "o", "\u001b[94mfn\u001b[0m\u001b[90m \u001b[0m\u001b[92mfauxware\u001b[0m::main()\u001b[90m \u001b[0m->\u001b[90m \u001b[0m\u001b[4;92mint\u001b[0m\u001b[90m \u001b[0m{\r\n\u001b[90m    \u001b[0m\u001b[94mlet\u001b[0m\u001b[90m \u001b[0mv0:\u001b[90m \u001b[0m\u001b[4;92mstd\u001b[0m::io::stdio::Stdin;\u001b[90m  \u001b[0m\u001b[2m// [bp-0x60]\u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[94mlet\u001b[0m\u001b[90m \u001b[0mv1:\u001b[90m \u001b[0m\u001b[96mu8\u001b[0m;\u001b[90m  \u001b[0m\u001b[2m// [bp-0x51]\u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[94mlet\u001b[0m\u001b[90m \u001b[0mv2:\u001b[90m \u001b[0m\u001b[96mu8\u001b[0m;\u001b[90m  \u001b[0m\u001b[2m// [bp-0x49]\u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[94mlet\u001b[0m\u001b[90m \u001b[0mv3:\u001b[90m \u001b[0m\u001b[96mu8\u001b[0m;\u001b[90m  \u001b[0m\u001b[2m// [bp-0x41]\u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[94mlet\u001b[0m\u001b[90m \u001b[0mv4:\u001b[90m \u001b[0m\u001b[96mu64\u001b[0m;\u001b[90m  \u001b[0m\u001b[2m// [bp-0x38]\u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[94mlet\u001b[0m\u001b[90m \u001b[0mv5:\u001b[90m \u001b[0m\u001b[96mu64\u001b[0m;\u001b[90m  \u001b[0m\u001b[2m// [bp-0x28]\u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[94mlet\u001b[0m\u001b[90m \u001b[0mv6:\u001b[90m \u001b[0m\u001b[96mu64\u001b[0m;\u001b[90m  \u001b[0m\u001b[2m// [bp-0x18]\u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[94mlet\u001b[0m\u001b[90m \u001b[0mv7:\u001b[90m \u001b[0m\u001b[96mu64\u001b[0m;\u001b[90m  \u001b[0m\u001b[2m// [bp-0x8]\u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[94mlet\u001b[0m\u001b[90m \u001b[0mv10:\u001b[90m \u001b[0m\u001b[4;92mstruct16\u001b[0m;\u001b[90m  \u001b[0m\u001b[2m// rax:rdx\u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[94mlet\u001b[0m\u001b[90m \u001b[0mv11:\u001b[90m \u001b[0m\u001b[4;92mcore\u001b[0m::result::\u001b[96mResult\u001b[0m<\u001b[96musize\u001b[0m,\u001b[90m \u001b[0mstd::io::error::Error>;\u001b[90m  \u001b[0m\u001b[2m// rax:rdx\u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[94mlet\u001b[0m\u001b[90m \u001b[0mv12:\u001b[90m \u001b[0m\u001b[4;92mcore\u001b[0m::result::\u001b[96mResult\u001b[0m<\u001b[96musize\u001b[0m,\u001b[90m \u001b[0mstd::io::error::Error>;\u001b[90m  \u001b[0m\u001b[2m// rax:rdx\u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[94mlet\u001b[0m\u001b[90m \u001b[0mv13:\u001b[90m \u001b[0m\u001b[4;92mcore\u001b[0m::result::\u001b[96mResult\u001b[0m<\u001b[96musize\u001b[0m,\u001b[90m \u001b[0mstd::io::error::Error>;\u001b[90m  \u001b[0m\u001b[2m// rax:rdx\u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[94mlet\u001b[0m\u001b[90m \u001b[0mv14:\u001b[90m \u001b[0m\u001b[4;92mcore\u001b[0m::result::\u001b[96mResult\u001b[0m<\u001b[96musize\u001b[0m,\u001b[90m \u001b[0mstd::io::error::Error>;\u001b[90m  \u001b[0m\u001b[2m// rax:rdx\u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[94mlet\u001b[0m\u001b[90m \u001b[0mv15:\u001b[90m \u001b[0m\u001b[4;92mstruct16\u001b[0m;\u001b[90m  \u001b[0m\u001b[2m// rax:rdx\u001b[0m\r\n\r\n\u001b[90m    \u001b[0mv0\u001b[90m \u001b[0m=\u001b[90m \u001b[0mstd::io::stdio::stdin();\r\n\u001b[90m    \u001b[0mmemset(&v1,\u001b[90m \u001b[0m\u001b[94m0\u001b[0m,\u001b[90m \u001b[0m\u001b[94m8\u001b[0m);\r\n\u001b[90m    \u001b[0mmemset(&v2,\u001b[90m \u001b[0m\u001b[94m0\u001b[0m,\u001b[90m \u001b[0m\u001b[94m8\u001b[0m);\r\n\u001b[90m    \u001b[0mv3\u001b[90m \u001b[0m=\u001b[90m \u001b[0m\u001b[94m0\u001b[0m;\r\n\u001b[90m    \u001b[0mv10\u001b[90m \u001b[0m=\u001b[90m \u001b[0m<core::fmt::Arguments>::from_str(\u001b[33m\"\u001b[0m\u001b[33mUsername: \u001b[0m\u001b[33m\\n\u001b[0m\u001b[33m\"\u001b[0m);\r\n\u001b[90m    \u001b[0mstd::io::stdio::_print(v10\u001b[90m \u001b[0m\u001b[94mas\u001b[0m\u001b[90m \u001b[0m\u001b[96mu64\u001b[0m);\r\n\u001b[90m    \u001b[0mv13\u001b[90m \u001b[0m=\u001b[90m \u001b[0m<std::io::stdio::Stdin\u001b[90m \u001b[0m\u001b[94mas\u001b[0m\u001b[90m \u001b[0mstd::io::Read>::read(&v0,\u001b[90m \u001b[0m&v1,\u001b[90m \u001b[0m\u001b[94m8\u001b[0m);\r\n\u001b[90m    \u001b[0mv4\u001b[90m \u001b[0m=\u001b[90m \u001b[0m*((&v13\u001b[90m \u001b[0m\u001b[94mas\u001b[0m\u001b[90m \u001b[0m&\u001b[96mchar\u001b[0m\u001b[90m \u001b[0m+\u001b[90m \u001b[0m\u001b[94m8\u001b[0m)\u001b[90m \u001b[0m\u001b[94mas\u001b[0m\u001b[90m \u001b[0m&\u001b[96mi64\u001b[0m);\r\n\u001b[90m    \u001b[0mcore::ptr::drop_glue::<core::result::\u001b[96mResult\u001b[0m<\u001b[96musize\u001b[0m,\u001b[90m \u001b[0mcore::io::error::Error>>(&v13\u001b[90m \u001b[0m\u001b[94mas\u001b[0m\u001b[90m \u001b[0m\u001b[96mi64\u001b[0m);\r\n\u001b[90m    \u001b[0mv14\u001b[90m \u001b[0m=\u001b[90m \u001b[0m<std::io::stdio::Stdin\u001b[90m \u001b[0m\u001b[94mas\u001b[0m\u001b[90m \u001b[0mstd::io::Read>::read(&v0,\u001b[90m \u001b[0m&v3,\u001b[90m \u001b[0m\u001b[94m1\u001b[0m);\r\n\u001b[90m    \u001b[0mv5\u001b[90m \u001b[0m=\u001b[90m \u001b[0m*((&v14\u001b[90m \u001b[0m\u001b[94mas\u001b[0m\u001b[90m \u001b[0m&\u001b[96mchar\u001b[0m\u001b[90m \u001b[0m+\u001b[90m \u001b[0m\u001b[94m8\u001b[0m)\u001b[90m \u001b[0m\u001b[94mas\u001b[0m\u001b[90m \u001b[0m&\u001b[96mi64\u001b[0m);\r\n\u001b[90m    \u001b[0mcore::ptr::drop_glue::<core::result::\u001b[96mResult\u001b[0m<\u001b[96musize\u001b[0m,\u001b[90m \u001b[0mcore::io::error::Error>>(&v14\u001b[90m \u001b[0m\u001b[94mas\u001b[0m\u001b[90m \u001b[0m\u001b[96mi64\u001b[0m);\r\n\u001b[90m    \u001b[0mv15\u001b[90m \u001b[0m=\u001b[90m \u001b[0m<core::fmt::Arguments>::from_str(\u001b[33m\"\u001b[0m\u001b[33mPassword: \u001b[0m\u001b[33m\\n\u001b[0m\u001b[33m\"\u001b[0m);\r\n\u001b[90m    \u001b[0mstd::io::stdio::_print(v15\u001b[90m \u001b[0m\u001b[94mas\u001b[0m\u001b[90m \u001b[0m\u001b[96mu64\u001b[0m);\r\n\u001b[90m    \u001b[0mv12\u001b[90m \u001b[0m=\u001b[90m \u001b[0m<std::io::stdio::Stdin\u001b[90m \u001b[0m\u001b[94mas\u001b[0m\u001b[90m \u001b[0mstd::io::Read>::read(&v0,\u001b[90m \u001b[0m&v2,\u001b[90m \u001b[0m\u001b[94m8\u001b[0m);\r\n\u001b[90m    \u001b[0mv6\u001b[90m \u001b[0m=\u001b[90m \u001b[0m*((&v12\u001b[90m \u001b[0m\u001b[94mas\u001b[0m\u001b[90m \u001b[0m&\u001b[96mchar\u001b[0m\u001b[90m \u001b[0m+\u001b[90m \u001b[0m\u001b[94m8\u001b[0m)\u001b[90m \u001b[0m\u001b[94mas\u001b[0m\u001b[90m \u001b[0m&\u001b[96mi64\u001b[0m);\r\n\u001b[90m    \u001b[0mcore::ptr::drop_glue::<core::result::\u001b[96mResult\u001b[0m<\u001b[96musize\u001b[0m,\u001b[90m \u001b[0mcore::io::error::Error>>(&v12\u001b[90m \u001b[0m\u001b[94mas\u001b[0m\u001b[90m \u001b[0m\u001b[96mi64\u001b[0m);\r\n\u001b[90m    \u001b[0mv11\u001b[90m \u001b[0m=\u001b[90m \u001b[0m<std::io::stdio::Stdin\u001b[90m \u001b[0m\u001b[94mas\u001b[0m\u001b[90m \u001b[0mstd::io::Read>::read(&v0,\u001b[90m \u001b[0m&v3,\u001b[90m \u001b[0m\u001b[94m1\u001b[0m);\r\n\u001b[90m    \u001b[0mv7\u001b[90m \u001b[0m=\u001b[90m \u001b[0m*((&v11\u001b[90m \u001b[0m\u001b[94mas\u001b[0m\u001b[90"]
[9.2765, "o", "m \u001b[0m&\u001b[96mchar\u001b[0m\u001b[90m \u001b[0m+\u001b[90m \u001b[0m\u001b[94m8\u001b[0m)\u001b[90m \u001b[0m\u001b[94mas\u001b[0m\u001b[90m \u001b[0m&\u001b[96mi64\u001b[0m);\r\n\u001b[90m    \u001b[0mcore::ptr::drop_glue::<core::result::\u001b[96mResult\u001b[0m<\u001b[96musize\u001b[0m,\u001b[90m \u001b[0mcore::io::error::Error>>(&v11\u001b[90m \u001b[0m\u001b[94mas\u001b[0m\u001b[90m \u001b[0m\u001b[96mi64\u001b[0m);\r\n\u001b[90m    \u001b[0m\u001b[94mif\u001b[0m\u001b[90m \u001b[0mfauxware::authenticate(&v1,\u001b[90m \u001b[0m&v2)\u001b[90m \u001b[0m\u001b[94mas\u001b[0m\u001b[90m \u001b[0m\u001b[96mchar\u001b[0m\u001b[90m \u001b[0m{\r\n\u001b[90m        \u001b[0m\u001b[94mreturn\u001b[0m\u001b[90m \u001b[0mfauxware::accepted();\r\n\u001b[90m    \u001b[0m}\r\n\u001b[90m    \u001b[0mfauxware::rejected();\u001b[90m \u001b[0m\u001b[2m/*\u001b[0m\u001b[2m do not return \u001b[0m\u001b[2m*/\u001b[0m\r\n}\r\n\r\n\r\n\u001b[?25l"]
