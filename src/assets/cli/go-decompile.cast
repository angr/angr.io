[9.6998, "o", "\u001b[94mfunc\u001b[0m\u001b[90m \u001b[0mmain.authenticate(a0\u001b[90m \u001b[0m\u001b[96mint\u001b[0m,\u001b[90m \u001b[0ma1\u001b[90m \u001b[0m\u001b[96mint\u001b[0m,\u001b[90m \u001b[0ma2\u001b[90m \u001b[0m\u001b[96muint64\u001b[0m,\u001b[90m \u001b[0ma3\u001b[90m \u001b[0munsafe.Pointer,\u001b[90m \u001b[0ma4\u001b[90m \u001b[0m\u001b[96mint\u001b[0m,\u001b[90m \u001b[0ma5\u001b[90m \u001b[0m\u001b[96muint64\u001b[0m)\u001b[90m \u001b[0m(\u001b[96mbool\u001b[0m,\u001b[90m \u001b[0m\u001b[96muintptr\u001b[0m)\u001b[90m \u001b[0m{\r\n\u001b[90m    \u001b[0m\u001b[94mvar\u001b[0m\u001b[90m \u001b[0mv6\u001b[90m \u001b[0m\u001b[96muint8\u001b[0m\u001b[90m  \u001b[0m\u001b[2m// al\u001b[0m\r\n\u001b[90m    \u001b[0m\u001b[94mvar\u001b[0m\u001b[90m \u001b[0mv7\u001b[90m \u001b[0m\u001b[96mint\u001b[0m\u001b[90m  \u001b[0m\u001b[2m// rbx\u001b[0m\r\n\r\n\u001b[90m    \u001b[0m\u001b[94mif\u001b[0m\u001b[90m \u001b[0m\u001b[96mstring\u001b[0m{ptr:\u001b[90m \u001b[0ma3,\u001b[90m \u001b[0mlen:\u001b[90m \u001b[0ma4}\u001b[90m \u001b[0m==\u001b[90m \u001b[0m\u001b[33m\"SOSNEAKY\"\u001b[0m\u001b[90m \u001b[0m{\r\n\u001b[90m        \u001b[0m\u001b[94mreturn\u001b[0m\u001b[90m \u001b[0m\u001b[94m1\u001b[0m,\u001b[90m \u001b[0ma1\r\n\u001b[90m    \u001b[0m}\r\n\u001b[90m    \u001b[0mv0\u001b[90m \u001b[0m:=\u001b[90m \u001b[0m\u001b[94m0\u001b[0m\r\n\u001b[90m    \u001b[0mv2\u001b[90m \u001b[0m:=\u001b[90m \u001b[0ma0\r\n\u001b[90m    \u001b[0mr1,\u001b[90m \u001b[0mr2,\u001b[90m \u001b[0merr\u001b[90m \u001b[0m:=\u001b[90m \u001b[0msyscall.RawSyscall(\u001b[94m2\u001b[0m,\u001b[90m \u001b[0ma0,\u001b[90m \u001b[0m\u001b[94m0\u001b[0m,\u001b[90m \u001b[0m\u001b[94m0\u001b[0m)\r\n\u001b[90m    \u001b[0mv1\u001b[90m \u001b[0m:=\u001b[90m \u001b[0m&v0\r\n\u001b[90m    \u001b[0mr12,\u001b[90m \u001b[0mr22,\u001b[90m \u001b[0merr2\u001b[90m \u001b[0m:=\u001b[90m \u001b[0msyscall.RawSyscall(\u001b[94m0\u001b[0m,\u001b[90m \u001b[0mr1,\u001b[90m \u001b[0m&v0,\u001b[90m \u001b[0m\u001b[94m8\u001b[0m)\r\n\u001b[90m    \u001b[0m\u001b[94mif\u001b[0m\u001b[90m \u001b[0ma4\u001b[90m \u001b[0m!=\u001b[90m \u001b[0m\u001b[94m8\u001b[0m\u001b[90m \u001b[0m{\r\n\u001b[90m        \u001b[0mv6\u001b[90m \u001b[0m=\u001b[90m \u001b[0m\u001b[94m0\u001b[0m\r\n\u001b[90m        \u001b[0mv7\u001b[90m \u001b[0m=\u001b[90m \u001b[0mr22\r\n\u001b[90m    \u001b[0m}\u001b[90m \u001b[0m\u001b[94melse\u001b[0m\u001b[90m \u001b[0m{\r\n\u001b[90m        \u001b[0mv6\u001b[90m \u001b[0m=\u001b[90m \u001b[0mruntime.memequal(a3,\u001b[90m \u001b[0m&v0,\u001b[90m \u001b[0m\u001b[94m8\u001b[0m)\r\n\u001b[90m    \u001b[0m}\r\n\u001b[90m    \u001b[0m\u001b[94mreturn\u001b[0m\u001b[90m \u001b[0mv6,\u001b[90m \u001b[0mv7\r\n}\r\n\r\n\r\n"]
