---
import { Code } from "astro:components";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "@/components/Icon.astro";
import notebooks from "@/assets/hero/notebooks.json";
import casts from "@/assets/cli/manifest.json";

// The showcase is a 3-axis picker — interface × language × analysis — over 27
// real angr sessions on the same program (fauxware, built from C, Go and
// Rust). Every tile is generated from real angr by the scripts in hero/:
//   cli      asciinema casts        hero/record_cli.py      -> src/assets/cli
//   ipython  static notebooks       hero/build_notebooks.py -> src/assets/hero
//   gui      angr-management shots  hero/shoot_gui.py       -> src/assets/gui

const IFACES = [
  { id: "cli", label: "CLI", title: "angr" },
  { id: "ipython", label: "IPython", title: "ipython" },
  { id: "gui", label: "GUI", title: "angr management" },
] as const;
const LANGS = [
  { id: "c", label: "C" },
  { id: "go", label: "Go" },
  { id: "rust", label: "Rust" },
] as const;
const MODES = [
  { id: "decompile", label: "Decompile" },
  { id: "disasm", label: "Disassemble" },
  { id: "symexec", label: "Symbolic execution" },
] as const;
const DEFAULT = { iface: "cli", lang: "c", mode: "decompile" };

// --- CLI casts -------------------------------------------------------------
const castUrls = import.meta.glob("../assets/cli/*.cast", {
  query: "?url",
  import: "default",
  eager: true,
}) as Record<string, string>;
const castRaws = import.meta.glob("../assets/cli/*.cast", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>;
const byId = <T,>(mods: Record<string, T>) =>
  Object.fromEntries(
    Object.entries(mods).map(([p, v]) => [p.split("/").pop()!.replace(".cast", ""), v])
  ) as Record<string, T>;
const castUrl = byId(castUrls);
const castRaw = byId(castRaws);
const castById = Object.fromEntries(casts.map((c: any) => [c.id, c]));

// Plain-text transcript of a cast (for the no-JS fallback of the default tile).
const transcript = (id: string) =>
  (castRaw[id] || "")
    .split("\n")
    .slice(1)
    .map((line) => {
      try {
        return JSON.parse(line);
      } catch {
        return null;
      }
    })
    .filter((ev) => ev && ev[1] === "o")
    .map((ev) => ev[2])
    .join("")
    .replace(/\x1b\[[0-9;?]*[a-zA-Z]/g, "")
    .replace(/\r/g, "")
    .trimEnd();

// --- angr-management screenshots -------------------------------------------
const shots = import.meta.glob<{ default: ImageMetadata }>("../assets/gui/*.png", {
  eager: true,
});
const shot = (lang: string, mode: string, theme: string) =>
  shots[`../assets/gui/${lang}-${mode}-${theme}.png`]?.default;

// --- IPython notebooks -----------------------------------------------------
const nbById = Object.fromEntries(notebooks.map((nb: any) => [nb.id, nb]));

const tiles = IFACES.flatMap((i) =>
  LANGS.flatMap((l) =>
    MODES.map((m) => ({
      id: `${i.id}-${l.id}-${m.id}`,
      iface: i.id,
      lang: l.id,
      mode: m.id,
      key: `${l.id}-${m.id}`,
    }))
  )
);
const isDefault = (t: { iface: string; lang: string; mode: string }) =>
  t.iface === DEFAULT.iface && t.lang === DEFAULT.lang && t.mode === DEFAULT.mode;
const defaultCast = castById[`${DEFAULT.lang}-${DEFAULT.mode}`];
---

<section id="showcase" class="section">
  <div class="container-page">
    <header class="section-head reveal">
      <p class="kicker">// angr, your way</p>
      <h2>Any interface. Any language. Any analysis.</h2>
      <p class="sub">
        Pick how you want to drive angr, what the binary was written in, and
        what you want out of it. Every combination below is real angr output
        on the same program — the classic <strong>fauxware</strong> backdoor,
        built from C, Go, and Rust.
      </p>
    </header>

    <div
      class="matrix card ticked reveal"
      data-showcase
      data-default={`${DEFAULT.iface}|${DEFAULT.lang}|${DEFAULT.mode}`}
    >
      <div class="picker">
        {
          [
            { axis: "iface", label: "Interface", opts: IFACES, cur: DEFAULT.iface },
            { axis: "lang", label: "Written in", opts: LANGS, cur: DEFAULT.lang },
            { axis: "mode", label: "Analysis", opts: MODES, cur: DEFAULT.mode },
          ].map((g) => (
            <div class="axis" role="radiogroup" aria-label={g.label} data-axis={g.axis}>
              <span class="axis-label">{g.label}</span>
              <div class="seg">
                {g.opts.map((o) => (
                  <button
                    type="button"
                    role="radio"
                    aria-checked={o.id === g.cur ? "true" : "false"}
                    tabindex={o.id === g.cur ? "0" : "-1"}
                    data-value={o.id}
                  >
                    {o.label}
                  </button>
                ))}
              </div>
            </div>
          ))
        }
      </div>

      <div class="term-bar">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        <span class="term-title" data-title>fauxware — angr</span>
      </div>

      <div class="stage" data-stage>
        {
          tiles.map((t) => {
            const hidden = !isDefault(t);
            if (t.iface === "cli") {
              const c = castById[t.key];
              return (
                <div
                  class="tile cast-tile"
                  data-tile={t.id}
                  data-cast={castUrl[t.key]}
                  data-display={c?.display}
                  hidden={hidden}
                >
                  <div class="cast-mount" role="img" aria-label={`Recorded angr session: ${c?.display}`} />
                  {!hidden && (
                    <noscript>
                      <pre class="cast-fallback">{transcript(t.key)}</pre>
                    </noscript>
                  )}
                </div>
              );
            }
            if (t.iface === "ipython") {
              const nb = nbById[t.key];
              return (
                <div class="tile nb-tile" data-tile={t.id} hidden={hidden}>
                  {nb.cells.map((cell: any) => (
                    <div class="cell">
                      <div class="line">
                        <span class="prompt in">In [{cell.n}]:</span>
                        <div class="content">
                          <Code
                            code={cell.code}
                            lang="python"
                            themes={{ light: "github-light", dark: "one-dark-pro" }}
                          />
                        </div>
                      </div>
                      {cell.streamHtml && (
                        <div class="line">
                          <span class="prompt" />
                          <pre class="content stream" set:html={cell.streamHtml} />
                        </div>
                      )}
                      {cell.out && (
                        <div class="line">
                          <span class="prompt out">Out[{cell.n}]:</span>
                          <pre class="content plain out-val">{cell.out}</pre>
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              );
            }
            const light = shot(t.lang, t.mode, "light");
            const dark = shot(t.lang, t.mode, "dark");
            const alt = `angr-management ${MODES.find((m) => m.id === t.mode)!.label.toLowerCase()} view of fauxware built from ${LANGS.find((l) => l.id === t.lang)!.label}`;
            return (
              <div class="tile gui-tile" data-tile={t.id} hidden={hidden}>
                {light && (
                  <Image
                    src={light}
                    alt={alt}
                    widths={[720, 1080, 1440, 2160]}
                    sizes="(min-width: 1280px) 73rem, 100vw"
                    loading="lazy"
                    class="shot shot-light"
                  />
                )}
                {dark && (
                  <Image
                    src={dark}
                    alt={alt}
                    widths={[720, 1080, 1440, 2160]}
                    sizes="(min-width: 1280px) 73rem, 100vw"
                    loading="lazy"
                    class="shot shot-dark"
                  />
                )}
              </div>
            );
          })
        }
      </div>

      <div class="status">
        <code class="cmd" data-cmd>{defaultCast?.display}</code>
      </div>
    </div>

    <div class="cta reveal">
      <a href="https://docs.angr.io" target="_blank" rel="noopener" class="btn btn-ghost">
        <Icon name="book" size={18} /> Read the docs
      </a>
      <a href="https://github.com/angr/angr-management" target="_blank" rel="noopener" class="btn btn-ghost">
        <Icon name="arrow-up-right" size={18} /> Get angr-management
      </a>
    </div>
  </div>
</section>

<style>
  .section {
    padding-block: clamp(3.5rem, 7vw, 6rem);
  }
  .section-head {
    max-width: 44rem;
    margin-bottom: 2.25rem;
  }
  .section-head h2 {
    font-size: clamp(1.9rem, 4vw, 2.85rem);
    font-weight: 800;
    letter-spacing: -0.03em;
    margin: 0.75rem 0 0.9rem;
  }
  .section-head .sub {
    font-size: 1.08rem;
    line-height: 1.6;
    color: var(--fg-muted);
  }
  .section-head strong {
    color: var(--fg);
  }

  .matrix {
    overflow: hidden;
  }

  /* ---- The three-axis picker ---- */
  .picker {
    display: grid;
    gap: 0.75rem 1.5rem;
    padding: 0.9rem 1rem;
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }
  @media (min-width: 820px) {
    .picker {
      grid-template-columns: repeat(3, auto);
      justify-content: space-between;
    }
  }
  .axis {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }
  .axis-label {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .seg {
    display: inline-flex;
    padding: 0.2rem;
    gap: 0.15rem;
    border: 1px solid var(--line);
    border-radius: 0.65rem;
    background: var(--surface);
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .seg::-webkit-scrollbar {
    display: none;
  }
  .seg button {
    flex: 0 0 auto;
    padding: 0.42rem 0.8rem;
    border: none;
    border-radius: 0.45rem;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--fg-muted);
    cursor: pointer;
    white-space: nowrap;
    transition:
      color 0.18s ease,
      background-color 0.18s ease;
  }
  .seg button:hover {
    color: var(--fg);
  }
  .seg button[aria-checked="true"] {
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 12%, transparent);
  }
  .seg button:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 1px;
  }
  @media (max-width: 480px) {
    .seg {
      display: flex;
      width: 100%;
    }
    .seg button {
      flex: 1 1 auto;
      padding-inline: 0.45rem;
      font-size: 0.74rem;
    }
  }

  /* ---- Window chrome ---- */
  .term-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }
  .dot {
    width: 0.72rem;
    height: 0.72rem;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .dot:nth-child(1) {
    background: #ff5f57;
  }
  .dot:nth-child(2) {
    background: #febc2e;
  }
  .dot:nth-child(3) {
    background: #28c840;
  }
  .term-title {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--fg-faint);
  }

  /* ---- Stage: a fixed 16:10 window every tile fits into, so switching
     between a cast, a notebook and a screenshot never reflows the page. ---- */
  .stage {
    position: relative;
    aspect-ratio: 16 / 10;
    min-height: 24rem;
    max-height: 46rem;
    background: var(--surface);
  }
  .tile {
    position: absolute;
    inset: 0;
    overflow: auto;
    scrollbar-width: thin;
  }
  .tile[hidden] {
    display: none;
  }

  /* CLI: asciinema player, font fitted to the width (110-col casts). */
  .cast-tile {
    padding: 0.2rem 0.3rem;
    overflow: hidden;
  }
  .cast-mount {
    width: 100%;
    transition: opacity 0.15s ease;
  }
  :global(.js) .cast-mount {
    aspect-ratio: 1 / 0.5225;
    overflow: hidden;
  }
  .cast-mount.is-loading {
    opacity: 0;
    transition: none;
  }
  .cast-fallback {
    margin: 0;
    padding: 0.6rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--fg-muted);
    white-space: pre-wrap;
  }

  /* IPython: the static notebook, same rendering as the hero. */
  .nb-tile {
    padding: 1rem 1.1rem 2rem;
  }
  .cell {
    font-family: var(--font-mono);
    font-size: clamp(0.68rem, 1.4vw, 0.8rem);
    line-height: 1.5;
  }
  .cell + .cell {
    margin-top: 0.85rem;
  }
  .line {
    display: grid;
    grid-template-columns: 3.7rem 1fr;
    column-gap: 0.55rem;
  }
  .line + .line {
    margin-top: 0.2rem;
  }
  .prompt {
    text-align: right;
    white-space: nowrap;
    user-select: none;
  }
  .prompt.in {
    color: #3fb950;
  }
  .prompt.out {
    color: var(--primary);
  }
  .content {
    min-width: 0;
  }
  .content :global(pre.astro-code) {
    margin: 0;
    padding: 0;
    background: transparent !important;
    font-size: inherit;
    line-height: inherit;
    overflow-x: auto;
  }
  .stream,
  .plain {
    margin: 0;
    font: inherit;
    white-space: pre;
    overflow-x: auto;
    color: var(--fg);
  }

  /* GUI: one screenshot per site theme, swapped with the palette. */
  .gui-tile {
    overflow: hidden;
    display: grid;
    place-items: start center;
  }
  .shot {
    display: block;
    width: 100%;
    height: auto;
  }
  .shot-dark {
    display: none;
  }
  :global([data-theme="dark"]) .shot-light {
    display: none;
  }
  :global([data-theme="dark"]) .shot-dark {
    display: block;
  }

  .status {
    display: flex;
    align-items: center;
    min-height: 2.6rem;
    padding: 0.55rem 1rem;
    border-top: 1px solid var(--line);
    background: var(--surface-2);
  }
  .cmd {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--fg-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cmd:empty::before {
    content: "\00a0";
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    justify-content: center;
    margin-top: 2rem;
  }
</style>

<script>
  import * as AsciinemaPlayer from "asciinema-player";
  import "asciinema-player/dist/bundle/asciinema-player.css";

  const IFACE_TITLE: Record<string, string> = {
    cli: "angr",
    ipython: "ipython",
    gui: "angr management",
  };
  const LANG_LABEL: Record<string, string> = { c: "C", go: "Go", rust: "Rust" };
  const NB_CMD: Record<string, string> = {
    decompile: "proj.analyses.Decompiler(...)",
    disasm: "proj.kb.functions[...].pp()",
    symexec: "simgr.explore(find=accepted)",
  };
  const GUI_CMD: Record<string, string> = {
    decompile: "Pseudocode view — decompiled with angr's own decompiler",
    disasm: "Disassembly view — control-flow graph",
    symexec: "Symbolic Execution view — explore to `accepted`",
  };

  const mount = () => {
    const root = document.querySelector<HTMLElement>("[data-showcase]");
    if (!root || root.dataset.bound) return;
    root.dataset.bound = "1";

    const tiles = Array.from(root.querySelectorAll<HTMLElement>("[data-tile]"));
    const groups = Array.from(root.querySelectorAll<HTMLElement>("[data-axis]"));
    const title = root.querySelector<HTMLElement>("[data-title]");
    const cmd = root.querySelector<HTMLElement>("[data-cmd]");
    const stage = root.querySelector<HTMLElement>("[data-stage]");
    const [iface0, lang0, mode0] = (root.dataset.default || "cli|c|decompile").split("|");
    const sel: Record<string, string> = { iface: iface0, lang: lang0, mode: mode0 };

    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let player: { dispose?: () => void } | null = null;
    let mountedIn: HTMLElement | null = null;
    let inView = false;

    const loadCast = (tile: HTMLElement) => {
      const el = tile.querySelector<HTMLElement>(".cast-mount");
      const src = tile.dataset.cast;
      if (!el || !src) return;
      if (player?.dispose) player.dispose();
      player = null;
      el.innerHTML = "";
      // Hide the brief oversized first render until asciinema has fitted the
      // font to the width (see CliShowcase history for the why).
      el.classList.add("is-loading");
      let tries = 0;
      const reveal = () => el.classList.remove("is-loading");
      const checkFitted = () => {
        const term = el.querySelector<HTMLElement>(".ap-term");
        const fitted = term && parseFloat(getComputedStyle(term).fontSize) < 18;
        if (fitted || tries++ > 40) reveal();
        else requestAnimationFrame(checkFitted);
      };
      requestAnimationFrame(checkFitted);
      player = AsciinemaPlayer.create(src, el, {
        autoPlay: !reduce,
        loop: !reduce,
        preload: true,
        controls: false,
        fit: "width",
        terminalFontFamily: "'JetBrains Mono Variable', ui-monospace, 'SF Mono', monospace",
        terminalLineHeight: 1.3,
        theme: "angr",
        poster: reduce ? "npt:9999:0" : undefined,
      });
      mountedIn = tile;
    };

    const unloadCast = () => {
      if (player?.dispose) player.dispose();
      player = null;
      if (mountedIn) {
        const el = mountedIn.querySelector<HTMLElement>(".cast-mount");
        if (el) el.innerHTML = "";
      }
      mountedIn = null;
    };

    const render = () => {
      const id = `${sel.iface}-${sel.lang}-${sel.mode}`;
      let current: HTMLElement | null = null;
      tiles.forEach((t) => {
        const on = t.dataset.tile === id;
        t.toggleAttribute("hidden", !on);
        if (on) current = t;
      });
      groups.forEach((g) => {
        const axis = g.dataset.axis!;
        g.querySelectorAll<HTMLButtonElement>("[role=radio]").forEach((b) => {
          const on = b.dataset.value === sel[axis];
          b.setAttribute("aria-checked", String(on));
          b.tabIndex = on ? 0 : -1;
        });
      });
      if (stage) stage.scrollTop = 0;
      if (title) title.textContent = `fauxware (${LANG_LABEL[sel.lang]}) — ${IFACE_TITLE[sel.iface]}`;
      if (cmd) {
        cmd.textContent =
          sel.iface === "cli"
            ? (current as HTMLElement | null)?.dataset.display || ""
            : sel.iface === "ipython"
              ? NB_CMD[sel.mode]
              : GUI_CMD[sel.mode];
      }
      // Only one asciinema player lives at a time; mount it for a visible
      // CLI tile (once scrolled into view) and tear it down otherwise.
      if (current && sel.iface === "cli" && inView) {
        if (mountedIn !== current) loadCast(current);
      } else {
        unloadCast();
      }
    };

    groups.forEach((g) => {
      const axis = g.dataset.axis!;
      const buttons = Array.from(g.querySelectorAll<HTMLButtonElement>("[role=radio]"));
      buttons.forEach((b, i) => {
        b.addEventListener("click", () => {
          sel[axis] = b.dataset.value!;
          render();
        });
        b.addEventListener("keydown", (e) => {
          if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
          e.preventDefault();
          const next = buttons[(i + (e.key === "ArrowRight" ? 1 : -1) + buttons.length) % buttons.length];
          sel[axis] = next.dataset.value!;
          render();
          next.focus();
        });
      });
    });

    // Start the cast only once the showcase scrolls into view, so it plays
    // from the top when the visitor gets there.
    const start = () => {
      inView = true;
      render();
    };
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries, obs) => {
          if (entries.some((e) => e.isIntersecting)) {
            obs.disconnect();
            start();
          }
        },
        { rootMargin: "0px 0px -20% 0px" }
      );
      io.observe(root);
    } else {
      start();
    }
    render();

    // asciinema bakes the palette into each drawn cell, so re-render the
    // current cast when the site theme flips. documentElement survives
    // view-transition swaps, so drop any observer from a previous page.
    const w = window as unknown as { __showcaseThemeObs?: MutationObserver };
    w.__showcaseThemeObs?.disconnect();
    const themeObserver = new MutationObserver(() => {
      if (mountedIn) loadCast(mountedIn);
    });
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
    w.__showcaseThemeObs = themeObserver;
  };

  mount();
  document.addEventListener("astro:after-swap", mount);
</script>
