---
import { Code } from "astro:components";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "@/components/Icon.astro";
import notebooks from "@/assets/hero/notebooks.json";
import casts from "@/assets/cli/manifest.json";

// The hero window is a 3-axis picker — interface × language × analysis — over
// 27 real angr sessions on the same program (fauxware, built from C, Go and
// Rust). Every tile is generated from real angr by the scripts in hero/:
//   cli      asciinema casts        hero/record_cli.py      -> src/assets/cli
//   ipython  static notebooks       hero/build_notebooks.py -> src/assets/hero
//   gui      angr-management shots  hero/shoot_gui.py       -> src/assets/gui

const IFACES = [
  { id: "cli", label: "CLI" },
  { id: "ipython", label: "IPython" },
  { id: "gui", label: "GUI" },
] as const;
const LANGS = [
  { id: "c", label: "C" },
  { id: "go", label: "Go" },
  { id: "rust", label: "Rust" },
] as const;
const MODES = [
  { id: "decompile", label: "Decompile" },
  { id: "disasm", label: "Disassemble" },
  { id: "symexec", label: "Symexec" },
] as const;
const DEFAULT = { iface: "cli", lang: "c", mode: "decompile" };

// --- CLI casts -------------------------------------------------------------
const castUrls = import.meta.glob("../assets/cli/*.cast", {
  query: "?url",
  import: "default",
  eager: true,
}) as Record<string, string>;
const castRaws = import.meta.glob("../assets/cli/*.cast", {
  query: "?raw",
  import: "default",
  eager: true,
}) as Record<string, string>;
const byId = <T,>(mods: Record<string, T>) =>
  Object.fromEntries(
    Object.entries(mods).map(([p, v]) => [p.split("/").pop()!.replace(".cast", ""), v])
  ) as Record<string, T>;
const castUrl = byId(castUrls);
const castRaw = byId(castRaws);
const castById = Object.fromEntries(casts.map((c: any) => [c.id, c]));

// Plain-text transcript of a cast (for the no-JS fallback of the default tile).
const transcript = (id: string) =>
  (castRaw[id] || "")
    .split("\n")
    .slice(1)
    .map((line) => {
      try {
        return JSON.parse(line);
      } catch {
        return null;
      }
    })
    .filter((ev) => ev && ev[1] === "o")
    .map((ev) => ev[2])
    .join("")
    .replace(/\x1b\[[0-9;?]*[a-zA-Z]/g, "")
    .replace(/\r/g, "")
    .trimEnd();

// --- angr-management screenshots -------------------------------------------
const shots = import.meta.glob<{ default: ImageMetadata }>("../assets/gui/*.png", {
  eager: true,
});
const shot = (lang: string, mode: string, theme: string) =>
  shots[`../assets/gui/${lang}-${mode}-${theme}.png`]?.default;

// --- IPython notebooks -----------------------------------------------------
const nbById = Object.fromEntries(notebooks.map((nb: any) => [nb.id, nb]));

const tiles = IFACES.flatMap((i) =>
  LANGS.flatMap((l) =>
    MODES.map((m) => ({
      id: `${i.id}-${l.id}-${m.id}`,
      iface: i.id,
      lang: l.id,
      mode: m.id,
      key: `${l.id}-${m.id}`,
    }))
  )
);
const isDefault = (t: { iface: string; lang: string; mode: string }) =>
  t.iface === DEFAULT.iface && t.lang === DEFAULT.lang && t.mode === DEFAULT.mode;
const defaultCast = castById[`${DEFAULT.lang}-${DEFAULT.mode}`];
const modeName = (id: string) =>
  ({ decompile: "decompilation", disasm: "disassembly", symexec: "symbolic execution" })[id];
---

<section class="hero">
  <div class="hero-glow reveal" aria-hidden="true"></div>
  <div class="container-page grid">
    <div class="copy">
      <p class="kicker reveal">// open-source binary analysis</p>
      <h1 class="reveal" style="--reveal-delay: 60ms">
        <span class="text-gradient">Demystify binaries.</span>
      </h1>
      <p class="lede reveal" style="--reveal-delay: 120ms">
        <strong>angr</strong> is a powerful Python platform for analyzing
        binaries, combining decompilation, symbolic execution, and more into one
        scriptable toolkit.
      </p>

      <div class="cta reveal" style="--reveal-delay: 180ms">
        <a href="#install" class="btn btn-primary">
          <Icon name="download" size={18} /> Install angr
        </a>
        <a
          href="https://github.com/angr/angr"
          target="_blank"
          rel="noopener"
          class="btn btn-ghost"
        >
          <Icon name="github" size={18} /> View on GitHub
        </a>
      </div>

      <dl class="stats reveal" style="--reveal-delay: 240ms">
        <div><dt>BSD</dt><dd>licensed</dd></div>
        <div><dt>8+</dt><dd>guest architectures</dd></div>
        <div><dt>1</dt><dd>pip install away</dd></div>
      </dl>
    </div>

    <div class="terminal-wrap reveal" style="--reveal-delay: 160ms">
      <div
        class="matrix card ticked"
        data-showcase
        data-default={`${DEFAULT.iface}|${DEFAULT.lang}|${DEFAULT.mode}`}
      >
        <div class="term-bar">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          <span class="term-title" data-title>fauxware (C) — angr</span>
        </div>

        <div class="stage-wrap">
          <div class="stage" data-stage>
            {
              tiles.map((t) => {
                const hidden = !isDefault(t);
                if (t.iface === "cli") {
                  const c = castById[t.key];
                  return (
                    <div
                      class="tile cast-tile"
                      data-tile={t.id}
                      data-cast={castUrl[t.key]}
                      data-display={c?.display}
                      hidden={hidden}
                    >
                      <div class="cast-mount" role="img" aria-label={`Recorded angr session: ${c?.display}`} />
                      {!hidden && (
                        <noscript>
                          <pre class="cast-fallback">{transcript(t.key)}</pre>
                        </noscript>
                      )}
                    </div>
                  );
                }
                if (t.iface === "ipython") {
                  const nb = nbById[t.key];
                  return (
                    <div class="tile nb-tile" data-tile={t.id} hidden={hidden}>
                      {nb.cells.map((cell: any) => (
                        <div class="cell">
                          <div class="line">
                            <span class="prompt in">In [{cell.n}]:</span>
                            <div class="content">
                              <Code
                                code={cell.code}
                                lang="python"
                                themes={{ light: "github-light", dark: "one-dark-pro" }}
                              />
                            </div>
                          </div>
                          {cell.streamHtml && (
                            <div class="line">
                              <span class="prompt" />
                              <pre class="content stream" set:html={cell.streamHtml} />
                            </div>
                          )}
                          {cell.out && (
                            <div class="line">
                              <span class="prompt out">Out[{cell.n}]:</span>
                              <pre class="content plain out-val">{cell.out}</pre>
                            </div>
                          )}
                        </div>
                      ))}
                    </div>
                  );
                }
                const light = shot(t.lang, t.mode, "light");
                const dark = shot(t.lang, t.mode, "dark");
                const alt = `angr-management ${modeName(t.mode)} view of fauxware built from ${LANGS.find((l) => l.id === t.lang)!.label}`;
                return (
                  <div class="tile gui-tile" data-tile={t.id} hidden={hidden}>
                    {light && (
                      <Image
                        src={light}
                        alt={alt}
                        widths={[720, 1080, 1440]}
                        sizes="(min-width: 980px) 42rem, 100vw"
                        loading="lazy"
                        class="shot shot-light"
                      />
                    )}
                    {dark && (
                      <Image
                        src={dark}
                        alt={alt}
                        widths={[720, 1080, 1440]}
                        sizes="(min-width: 980px) 42rem, 100vw"
                        loading="lazy"
                        class="shot shot-dark"
                      />
                    )}
                  </div>
                );
              })
            }
          </div>
          <div class="stage-fade" aria-hidden="true"></div>
        </div>

        <div class="status">
          <code class="cmd" data-cmd>{defaultCast?.display}</code>
        </div>

        <div class="picker">
          {
            [
              { axis: "iface", label: "Interface", opts: IFACES, cur: DEFAULT.iface },
              { axis: "lang", label: "Written in", opts: LANGS, cur: DEFAULT.lang },
              { axis: "mode", label: "Analysis", opts: MODES, cur: DEFAULT.mode },
            ].map((g) => (
              <div class="axis" role="radiogroup" aria-label={g.label} data-axis={g.axis}>
                <span class="axis-label">{g.label}</span>
                <div class="seg">
                  {g.opts.map((o) => (
                    <button
                      type="button"
                      role="radio"
                      aria-checked={o.id === g.cur ? "true" : "false"}
                      tabindex={o.id === g.cur ? "0" : "-1"}
                      data-value={o.id}
                    >
                      {o.label}
                    </button>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 8vw, 7rem) clamp(3rem, 6vw, 5rem);
  }
  .hero-glow {
    position: absolute;
    inset: -30% -10% auto -10%;
    height: 60rem;
    background:
      radial-gradient(40rem 28rem at 78% 8%, var(--glow), transparent 70%),
      radial-gradient(30rem 24rem at 10% 0%, color-mix(in srgb, var(--amber) 14%, transparent), transparent 70%);
    pointer-events: none;
    z-index: 0;
  }
  .grid {
    position: relative;
    z-index: 1;
    display: grid;
    /* Single column constrained to the viewport (not content-sized), so the
       notebook's long code lines scroll inside the panel instead of widening
       the whole hero off-screen on mobile. */
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }
  @media (min-width: 980px) {
    .grid {
      grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    }
  }

  h1 {
    font-size: clamp(2.6rem, 6.5vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 800;
    margin-block: 1rem 1.25rem;
  }
  .lede {
    font-size: clamp(1.05rem, 2vw, 1.22rem);
    line-height: 1.6;
    color: var(--fg-muted);
    max-width: 36rem;
  }
  .lede strong {
    color: var(--fg);
    font-weight: 700;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .stats {
    display: flex;
    gap: clamp(1rem, 5vw, 2.5rem);
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .stats dt {
    font-family: var(--font-mono);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--primary);
    line-height: 1;
  }
  .stats dd {
    margin: 0.35rem 0 0;
    font-size: 0.82rem;
    color: var(--fg-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* ---- The demo window ---- */
  .matrix {
    overflow: hidden;
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }
  .dot {
    width: 0.72rem;
    height: 0.72rem;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .dot:nth-child(1) {
    background: #ff5f57;
  }
  .dot:nth-child(2) {
    background: #febc2e;
  }
  .dot:nth-child(3) {
    background: #28c840;
  }
  .term-title {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--fg-faint);
  }

  /* Stage: a fixed window every tile fits into, so switching between a cast,
     a notebook and a screenshot never reflows the page. 16:10 like the
     angr-management shots, clamped so notebooks keep room on narrow screens. */
  .stage-wrap {
    position: relative;
  }
  .stage {
    position: relative;
    aspect-ratio: 16 / 10;
    min-height: 21rem;
    max-height: 27rem;
    background: var(--surface);
  }
  .stage-fade {
    position: absolute;
    inset: auto 0 0 0;
    height: 2.5rem;
    background: linear-gradient(transparent, var(--surface));
    pointer-events: none;
  }
  .tile {
    position: absolute;
    inset: 0;
    overflow: auto;
    scrollbar-width: thin;
  }
  .tile[hidden] {
    display: none;
  }

  /* CLI: asciinema player, font fitted to the width (110-col casts). */
  .cast-tile {
    padding: 0.2rem 0.3rem;
    overflow: hidden;
  }
  .cast-mount {
    width: 100%;
    transition: opacity 0.15s ease;
  }
  :global(.js) .cast-mount {
    aspect-ratio: 1 / 0.5225;
    overflow: hidden;
  }
  .cast-mount.is-loading {
    opacity: 0;
    transition: none;
  }
  .cast-fallback {
    margin: 0;
    padding: 0.6rem 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--fg-muted);
    white-space: pre-wrap;
  }

  /* IPython: the static notebook. */
  .nb-tile {
    padding: 1rem 1.1rem 2.5rem;
  }
  .cell {
    font-family: var(--font-mono);
    font-size: clamp(0.68rem, 1.4vw, 0.78rem);
    line-height: 1.5;
  }
  .cell + .cell {
    margin-top: 0.85rem;
  }
  .line {
    display: grid;
    grid-template-columns: 3.7rem 1fr;
    column-gap: 0.55rem;
  }
  .line + .line {
    margin-top: 0.2rem;
  }
  .prompt {
    text-align: right;
    white-space: nowrap;
    user-select: none;
  }
  /* IPython prompt colors: In green, Out red. */
  .prompt.in {
    color: #3fb950;
  }
  .prompt.out {
    color: var(--primary);
  }
  .content {
    min-width: 0;
  }
  .content :global(pre.astro-code) {
    margin: 0;
    padding: 0;
    background: transparent !important;
    font-size: inherit;
    line-height: inherit;
    overflow-x: auto;
  }
  .stream,
  .plain {
    margin: 0;
    font: inherit;
    white-space: pre;
    overflow-x: auto;
    color: var(--fg);
  }
  .out-val {
    color: var(--fg);
  }

  /* GUI: one screenshot per site theme, swapped with the palette. */
  .gui-tile {
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .shot {
    display: block;
    width: 100%;
    height: auto;
  }
  .shot-dark {
    display: none;
  }
  :global([data-theme="dark"]) .shot-light {
    display: none;
  }
  :global([data-theme="dark"]) .shot-dark {
    display: block;
  }

  .status {
    display: flex;
    align-items: center;
    min-height: 2.2rem;
    padding: 0.45rem 1rem;
    border-top: 1px solid var(--line);
    background: var(--surface-2);
  }
  .cmd {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--fg-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cmd:empty::before {
    content: "\00a0";
  }

  /* ---- The three-axis picker (where the tab strip used to be) ---- */
  .picker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.25rem;
    padding: 0.7rem 0.9rem 0.8rem;
    border-top: 1px solid var(--line);
    background: var(--surface-2);
  }
  .axis {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
    flex: 1 1 auto;
  }
  .axis-label {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .seg {
    display: flex;
    padding: 0.18rem;
    gap: 0.15rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: var(--surface);
    width: fit-content;
    max-width: 100%;
  }
  .seg button {
    flex: 1 1 auto;
    padding: 0.38rem 0.7rem;
    border: none;
    border-radius: 0.42rem;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--fg-muted);
    cursor: pointer;
    white-space: nowrap;
    transition:
      color 0.18s ease,
      background-color 0.18s ease;
  }
  .seg button:hover {
    color: var(--fg);
  }
  .seg button[aria-checked="true"] {
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 12%, transparent);
  }
  .seg button:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 1px;
  }
  @media (max-width: 480px) {
    .axis {
      flex-basis: 100%;
    }
    .seg {
      width: 100%;
    }
    .seg button {
      padding-inline: 0.45rem;
      font-size: 0.74rem;
    }
  }
</style>

<script>
  import * as AsciinemaPlayer from "asciinema-player";
  import "asciinema-player/dist/bundle/asciinema-player.css";

  const IFACE_TITLE: Record<string, string> = {
    cli: "angr",
    ipython: "ipython",
    gui: "angr management",
  };
  const LANG_LABEL: Record<string, string> = { c: "C", go: "Go", rust: "Rust" };
  const NB_CMD: Record<string, string> = {
    decompile: "proj.analyses.Decompiler(...)",
    disasm: "proj.kb.functions[...].pp()",
    symexec: "simgr.explore(find=accepted)",
  };
  const GUI_CMD: Record<string, string> = {
    decompile: "Pseudocode view — decompiled with angr's own decompiler",
    disasm: "Disassembly view — control-flow graph",
    symexec: "Symbolic Execution view — explore to `accepted`",
  };

  const mount = () => {
    const root = document.querySelector<HTMLElement>("[data-showcase]");
    if (!root || root.dataset.bound) return;
    root.dataset.bound = "1";

    const tiles = Array.from(root.querySelectorAll<HTMLElement>("[data-tile]"));
    const groups = Array.from(root.querySelectorAll<HTMLElement>("[data-axis]"));
    const title = root.querySelector<HTMLElement>("[data-title]");
    const cmd = root.querySelector<HTMLElement>("[data-cmd]");
    const stage = root.querySelector<HTMLElement>("[data-stage]");
    const [iface0, lang0, mode0] = (root.dataset.default || "cli|c|decompile").split("|");
    const sel: Record<string, string> = { iface: iface0, lang: lang0, mode: mode0 };

    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let player: { dispose?: () => void } | null = null;
    let mountedIn: HTMLElement | null = null;
    let inView = false;

    const loadCast = (tile: HTMLElement) => {
      const el = tile.querySelector<HTMLElement>(".cast-mount");
      const src = tile.dataset.cast;
      if (!el || !src) return;
      if (player?.dispose) player.dispose();
      player = null;
      el.innerHTML = "";
      // Hide the brief oversized first render until asciinema has fitted the
      // font to the width.
      el.classList.add("is-loading");
      let tries = 0;
      const reveal = () => el.classList.remove("is-loading");
      const checkFitted = () => {
        const term = el.querySelector<HTMLElement>(".ap-term");
        const fitted = term && parseFloat(getComputedStyle(term).fontSize) < 18;
        if (fitted || tries++ > 40) reveal();
        else requestAnimationFrame(checkFitted);
      };
      requestAnimationFrame(checkFitted);
      player = AsciinemaPlayer.create(src, el, {
        autoPlay: !reduce,
        loop: !reduce,
        preload: true,
        controls: false,
        fit: "width",
        terminalFontFamily: "'JetBrains Mono Variable', ui-monospace, 'SF Mono', monospace",
        terminalLineHeight: 1.3,
        theme: "angr",
        poster: reduce ? "npt:9999:0" : undefined,
      });
      mountedIn = tile;
    };

    const unloadCast = () => {
      if (player?.dispose) player.dispose();
      player = null;
      if (mountedIn) {
        const el = mountedIn.querySelector<HTMLElement>(".cast-mount");
        if (el) el.innerHTML = "";
      }
      mountedIn = null;
    };

    const render = () => {
      const id = `${sel.iface}-${sel.lang}-${sel.mode}`;
      let current: HTMLElement | null = null;
      tiles.forEach((t) => {
        const on = t.dataset.tile === id;
        t.toggleAttribute("hidden", !on);
        if (on) current = t;
      });
      groups.forEach((g) => {
        const axis = g.dataset.axis!;
        g.querySelectorAll<HTMLButtonElement>("[role=radio]").forEach((b) => {
          const on = b.dataset.value === sel[axis];
          b.setAttribute("aria-checked", String(on));
          b.tabIndex = on ? 0 : -1;
        });
      });
      if (stage) stage.scrollTop = 0;
      if (title) title.textContent = `fauxware (${LANG_LABEL[sel.lang]}) — ${IFACE_TITLE[sel.iface]}`;
      if (cmd) {
        cmd.textContent =
          sel.iface === "cli"
            ? (current as HTMLElement | null)?.dataset.display || ""
            : sel.iface === "ipython"
              ? NB_CMD[sel.mode]
              : GUI_CMD[sel.mode];
      }
      // Only one asciinema player lives at a time; mount it for a visible
      // CLI tile (once in view) and tear it down otherwise.
      if (current && sel.iface === "cli" && inView) {
        if (mountedIn !== current) loadCast(current);
      } else {
        unloadCast();
      }
    };

    groups.forEach((g) => {
      const axis = g.dataset.axis!;
      const buttons = Array.from(g.querySelectorAll<HTMLButtonElement>("[role=radio]"));
      buttons.forEach((b, i) => {
        b.addEventListener("click", () => {
          sel[axis] = b.dataset.value!;
          render();
        });
        b.addEventListener("keydown", (e) => {
          if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
          e.preventDefault();
          const next = buttons[(i + (e.key === "ArrowRight" ? 1 : -1) + buttons.length) % buttons.length];
          sel[axis] = next.dataset.value!;
          render();
          next.focus();
        });
      });
    });

    // Start the cast once the window is actually on screen, so it plays from
    // the top when the visitor sees it (immediately for the hero, but it also
    // covers view-transition swaps that land further down the page).
    const start = () => {
      inView = true;
      render();
    };
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries, obs) => {
          if (entries.some((e) => e.isIntersecting)) {
            obs.disconnect();
            start();
          }
        },
        { rootMargin: "0px 0px -20% 0px" }
      );
      io.observe(root);
    } else {
      start();
    }
    render();

    // asciinema bakes the palette into each drawn cell, so re-render the
    // current cast when the site theme flips. documentElement survives
    // view-transition swaps, so drop any observer from a previous page.
    const w = window as unknown as { __showcaseThemeObs?: MutationObserver };
    w.__showcaseThemeObs?.disconnect();
    const themeObserver = new MutationObserver(() => {
      if (mountedIn) loadCast(mountedIn);
    });
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
    w.__showcaseThemeObs = themeObserver;
  };

  mount();
  document.addEventListener("astro:after-swap", mount);
</script>
