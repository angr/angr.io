---
import { Code } from "astro:components";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Icon from "@/components/Icon.astro";
import notebooks from "@/assets/hero/notebooks.json";
import transcripts from "@/assets/cli/transcripts.json";

// The hero window is a 3-axis picker — interface × language × analysis — over
// 27 real angr sessions on the same program (fauxware, built from C, Go and
// Rust). Every tile is generated from real angr by the scripts in hero/:
//   cli      static transcripts     hero/capture_cli.py     -> src/assets/cli
//   ipython  static notebooks       hero/build_notebooks.py -> src/assets/hero
//   gui      angr-management shots  hero/shoot_gui.py       -> src/assets/gui

const IFACES = [
  { id: "cli", label: "CLI" },
  { id: "ipython", label: "IPython" },
  { id: "gui", label: "GUI" },
] as const;
const LANGS = [
  { id: "c", label: "C" },
  { id: "go", label: "Go" },
  { id: "rust", label: "Rust" },
] as const;
const MODES = [
  { id: "decompile", label: "Decompile" },
  { id: "disasm", label: "Disassemble" },
  { id: "symexec", label: "Symexec" },
] as const;
const DEFAULT = { iface: "cli", lang: "c", mode: "decompile" };

// --- CLI transcripts -------------------------------------------------------
// Each transcript is a list of steps: the command the prompt shows and its
// output, either the terminal's own ANSI-colored text as HTML or plain code
// that the site highlights (the decompile tab; see capture_cli.py).
const cliById = Object.fromEntries(transcripts.map((t: any) => [t.id, t]));

// --- angr-management screenshots -------------------------------------------
const shots = import.meta.glob<{ default: ImageMetadata }>("../assets/gui/*.png", {
  eager: true,
});
const shot = (lang: string, mode: string, theme: string) =>
  shots[`../assets/gui/${lang}-${mode}-${theme}.png`]?.default;

// --- IPython notebooks -----------------------------------------------------
const nbById = Object.fromEntries(notebooks.map((nb: any) => [nb.id, nb]));

const tiles = IFACES.flatMap((i) =>
  LANGS.flatMap((l) =>
    MODES.map((m) => ({
      id: `${i.id}-${l.id}-${m.id}`,
      iface: i.id,
      lang: l.id,
      mode: m.id,
      key: `${l.id}-${m.id}`,
    }))
  )
);
const isDefault = (t: { iface: string; lang: string; mode: string }) =>
  t.iface === DEFAULT.iface && t.lang === DEFAULT.lang && t.mode === DEFAULT.mode;
const defaultCli = cliById[`${DEFAULT.lang}-${DEFAULT.mode}`];
const modeName = (id: string) =>
  ({ decompile: "decompilation", disasm: "disassembly", symexec: "symbolic execution" })[id];
---

<section class="hero">
  <div class="hero-glow reveal" aria-hidden="true"></div>
  <div class="container-page grid">
    <div class="copy">
      <p class="kicker reveal">// open-source binary analysis</p>
      <h1 class="reveal" style="--reveal-delay: 60ms">
        <span class="text-gradient">Demystify binaries.</span>
      </h1>
      <p class="lede reveal" style="--reveal-delay: 120ms">
        <strong>angr</strong> is a powerful Python platform for analyzing
        binaries, combining decompilation, symbolic execution, and more into one
        scriptable toolkit.
      </p>

      <div class="cta reveal" style="--reveal-delay: 180ms">
        <a href="#install" class="btn btn-primary">
          <Icon name="download" size={18} /> Install angr
        </a>
        <a
          href="https://github.com/angr/angr"
          target="_blank"
          rel="noopener"
          class="btn btn-ghost"
        >
          <Icon name="github" size={18} /> View on GitHub
        </a>
      </div>

      <dl class="stats reveal" style="--reveal-delay: 240ms">
        <div><dt>BSD</dt><dd>licensed</dd></div>
        <div><dt>8+</dt><dd>guest architectures</dd></div>
        <div><dt>1</dt><dd>pip install away</dd></div>
      </dl>
    </div>

    <div class="terminal-wrap reveal" style="--reveal-delay: 160ms">
      <div
        class="matrix card ticked"
        data-showcase
        data-default={`${DEFAULT.iface}|${DEFAULT.lang}|${DEFAULT.mode}`}
      >
        <div class="term-bar">
          <span class="dot"></span><span class="dot"></span><span class="dot"></span>
          <span class="term-title" data-title>fauxware (C) — angr</span>
        </div>

        <div class="stage-wrap">
          <div class="stage" data-stage>
            {
              tiles.map((t) => {
                const hidden = !isDefault(t);
                if (t.iface === "cli") {
                  const c = cliById[t.key];
                  return (
                    <div class="tile cli-tile" data-tile={t.id} data-display={c.display} hidden={hidden}>
                      {c.steps.map((s: any) => (
                        <div class="step" data-step>
                          <div class="ps1">
                            <span class="dollar" aria-hidden="true">$</span>
                            <span class="typed" data-typed={s.cmd}>{s.cmd}</span>
                          </div>
                          {s.code != null ? (
                            <div class="term-out code" data-out>
                              <Code
                                code={s.code}
                                lang={s.lang}
                                themes={{ light: "github-light", dark: "one-dark-pro" }}
                              />
                            </div>
                          ) : (
                            <pre class="term-out" data-out set:html={s.html} />
                          )}
                        </div>
                      ))}
                    </div>
                  );
                }
                if (t.iface === "ipython") {
                  const nb = nbById[t.key];
                  return (
                    <div class="tile nb-tile" data-tile={t.id} hidden={hidden}>
                      {nb.cells.map((cell: any) => (
                        <div class="cell">
                          <div class="line">
                            <span class="prompt in">In [{cell.n}]:</span>
                            <div class="content">
                              <Code
                                code={cell.code}
                                lang="python"
                                themes={{ light: "github-light", dark: "one-dark-pro" }}
                              />
                            </div>
                          </div>
                          {cell.streamHtml && (
                            <div class="line">
                              <span class="prompt" />
                              <pre class="content stream" set:html={cell.streamHtml} />
                            </div>
                          )}
                          {cell.out && (
                            <div class="line">
                              <span class="prompt out">Out[{cell.n}]:</span>
                              <pre class="content plain out-val">{cell.out}</pre>
                            </div>
                          )}
                        </div>
                      ))}
                    </div>
                  );
                }
                const light = shot(t.lang, t.mode, "light");
                const dark = shot(t.lang, t.mode, "dark");
                const alt = `angr-management ${modeName(t.mode)} view of fauxware built from ${LANGS.find((l) => l.id === t.lang)!.label}`;
                return (
                  <div class="tile gui-tile" data-tile={t.id} hidden={hidden}>
                    {light && (
                      <Image
                        src={light}
                        alt={alt}
                        widths={[720, 1080, 1440]}
                        sizes="(min-width: 980px) 42rem, 100vw"
                        loading="lazy"
                        class="shot shot-light"
                      />
                    )}
                    {dark && (
                      <Image
                        src={dark}
                        alt={alt}
                        widths={[720, 1080, 1440]}
                        sizes="(min-width: 980px) 42rem, 100vw"
                        loading="lazy"
                        class="shot shot-dark"
                      />
                    )}
                  </div>
                );
              })
            }
          </div>
          <div class="stage-fade" aria-hidden="true"></div>
        </div>

        <div class="status">
          <code class="cmd" data-cmd>{defaultCli?.display}</code>
        </div>

        <div class="picker">
          {
            [
              { axis: "iface", label: "Interface", opts: IFACES, cur: DEFAULT.iface },
              { axis: "lang", label: "Written in", opts: LANGS, cur: DEFAULT.lang },
              { axis: "mode", label: "Analysis", opts: MODES, cur: DEFAULT.mode },
            ].map((g) => (
              <div class="axis" role="radiogroup" aria-label={g.label} data-axis={g.axis}>
                <span class="axis-label">{g.label}</span>
                <div class="seg">
                  {g.opts.map((o) => (
                    <button
                      type="button"
                      role="radio"
                      aria-checked={o.id === g.cur ? "true" : "false"}
                      tabindex={o.id === g.cur ? "0" : "-1"}
                      data-value={o.id}
                    >
                      {o.label}
                    </button>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 8vw, 7rem) clamp(3rem, 6vw, 5rem);
  }
  .hero-glow {
    position: absolute;
    inset: -30% -10% auto -10%;
    height: 60rem;
    background:
      radial-gradient(40rem 28rem at 78% 8%, var(--glow), transparent 70%),
      radial-gradient(30rem 24rem at 10% 0%, color-mix(in srgb, var(--amber) 14%, transparent), transparent 70%);
    pointer-events: none;
    z-index: 0;
  }
  .grid {
    position: relative;
    z-index: 1;
    display: grid;
    /* Single column constrained to the viewport (not content-sized), so the
       notebook's long code lines scroll inside the panel instead of widening
       the whole hero off-screen on mobile. */
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: center;
  }
  @media (min-width: 980px) {
    .grid {
      grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    }
  }

  h1 {
    font-size: clamp(2.6rem, 6.5vw, 4.6rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 800;
    margin-block: 1rem 1.25rem;
  }
  .lede {
    font-size: clamp(1.05rem, 2vw, 1.22rem);
    line-height: 1.6;
    color: var(--fg-muted);
    max-width: 36rem;
  }
  .lede strong {
    color: var(--fg);
    font-weight: 700;
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }

  .stats {
    display: flex;
    gap: clamp(1rem, 5vw, 2.5rem);
    margin-top: 2.5rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
  }
  .stats dt {
    font-family: var(--font-mono);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--primary);
    line-height: 1;
  }
  .stats dd {
    margin: 0.35rem 0 0;
    font-size: 0.82rem;
    color: var(--fg-faint);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* ---- The demo window ---- */
  .matrix {
    overflow: hidden;
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    background: var(--surface-2);
    border-bottom: 1px solid var(--line);
  }
  .dot {
    width: 0.72rem;
    height: 0.72rem;
    border-radius: 50%;
    background: var(--line-strong);
  }
  .dot:nth-child(1) {
    background: #ff5f57;
  }
  .dot:nth-child(2) {
    background: #febc2e;
  }
  .dot:nth-child(3) {
    background: #28c840;
  }
  .term-title {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--fg-faint);
  }

  /* Stage: a fixed window every tile fits into, so switching between a transcript,
     a notebook and a screenshot never reflows the page. 16:10 like the
     angr-management shots, clamped so notebooks keep room on narrow screens. */
  .stage-wrap {
    position: relative;
  }
  .stage {
    position: relative;
    /* Explicit width: otherwise the min-height is transferred through the
       aspect ratio into a min-width and the stage overflows the card on
       narrow screens. */
    width: 100%;
    aspect-ratio: 16 / 10;
    min-height: 21rem;
    max-height: 27rem;
    background: var(--surface);
  }
  .stage-fade {
    position: absolute;
    inset: auto 0 0 0;
    height: 2.5rem;
    background: linear-gradient(transparent, var(--surface));
    pointer-events: none;
  }
  .tile {
    position: absolute;
    inset: 0;
    overflow: auto;
    scrollbar-width: thin;
  }
  .tile[hidden] {
    display: none;
  }

  /* CLI: a static transcript. The prompt line types itself when the tile
     is shown; the output is the real command's stdout. */
  .cli-tile {
    padding: 0.9rem 1.1rem 2.5rem;
    font-family: var(--font-mono);
    font-size: clamp(0.68rem, 1.4vw, 0.78rem);
    line-height: 1.5;
  }
  .step + .step {
    margin-top: 0.9rem;
  }
  .ps1 {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--fg);
    margin-bottom: 0.45rem;
  }
  .dollar {
    color: var(--primary);
    font-weight: 700;
    margin-right: 1ch;
    user-select: none;
  }
  .typed.typing::after {
    content: "";
    display: inline-block;
    width: 0.55em;
    height: 1em;
    margin-left: 0.1em;
    vertical-align: -0.15em;
    background: var(--fg);
    animation: blink 1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .term-out {
    margin: 0;
    font: inherit;
    white-space: pre;
    overflow-x: auto;
    color: var(--fg);
  }
  .term-out[hidden],
  .step[hidden] {
    display: none;
  }
  .term-out :global(pre.astro-code) {
    margin: 0;
    padding: 0;
    background: transparent !important;
    font-size: inherit;
    line-height: inherit;
    overflow-x: auto;
  }

  /* IPython: the static notebook. */
  .nb-tile {
    padding: 1rem 1.1rem 2.5rem;
  }
  .cell {
    font-family: var(--font-mono);
    font-size: clamp(0.68rem, 1.4vw, 0.78rem);
    line-height: 1.5;
  }
  .cell + .cell {
    margin-top: 0.85rem;
  }
  .line {
    display: grid;
    grid-template-columns: 3.7rem 1fr;
    column-gap: 0.55rem;
  }
  .line + .line {
    margin-top: 0.2rem;
  }
  .prompt {
    text-align: right;
    white-space: nowrap;
    user-select: none;
  }
  /* IPython prompt colors: In green, Out red. */
  .prompt.in {
    color: #3fb950;
  }
  .prompt.out {
    color: var(--primary);
  }
  .content {
    min-width: 0;
  }
  .content :global(pre.astro-code) {
    margin: 0;
    padding: 0;
    background: transparent !important;
    font-size: inherit;
    line-height: inherit;
    overflow-x: auto;
  }
  .stream,
  .plain {
    margin: 0;
    font: inherit;
    white-space: pre;
    overflow-x: auto;
    color: var(--fg);
  }
  .out-val {
    color: var(--fg);
  }

  /* GUI: one screenshot per site theme, swapped with the palette. */
  .gui-tile {
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .shot {
    display: block;
    width: 100%;
    height: auto;
  }
  .shot-dark {
    display: none;
  }
  :global([data-theme="dark"]) .shot-light {
    display: none;
  }
  :global([data-theme="dark"]) .shot-dark {
    display: block;
  }

  .status {
    display: flex;
    align-items: center;
    min-height: 2.2rem;
    padding: 0.45rem 1rem;
    border-top: 1px solid var(--line);
    background: var(--surface-2);
  }
  .cmd {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--fg-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .cmd:empty::before {
    content: "\00a0";
  }

  /* ---- The three-axis picker (where the tab strip used to be) ---- */
  .picker {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem 1.25rem;
    padding: 0.7rem 0.9rem 0.8rem;
    border-top: 1px solid var(--line);
    background: var(--surface-2);
  }
  .axis {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
    flex: 1 1 auto;
  }
  .axis-label {
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .seg {
    display: flex;
    padding: 0.18rem;
    gap: 0.15rem;
    border: 1px solid var(--line);
    border-radius: 0.6rem;
    background: var(--surface);
    width: fit-content;
    max-width: 100%;
  }
  .seg button {
    flex: 1 1 auto;
    padding: 0.38rem 0.7rem;
    border: none;
    border-radius: 0.42rem;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--fg-muted);
    cursor: pointer;
    white-space: nowrap;
    transition:
      color 0.18s ease,
      background-color 0.18s ease;
  }
  .seg button:hover {
    color: var(--fg);
  }
  .seg button[aria-checked="true"] {
    color: var(--primary);
    background: color-mix(in srgb, var(--primary) 12%, transparent);
  }
  .seg button:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 1px;
  }
  @media (max-width: 480px) {
    .axis {
      flex-basis: 100%;
    }
    .seg {
      width: 100%;
    }
    .seg button {
      padding-inline: 0.45rem;
      font-size: 0.74rem;
    }
  }
</style>

<script>
  const IFACE_TITLE: Record<string, string> = {
    cli: "angr",
    ipython: "ipython",
    gui: "angr management",
  };
  const LANG_LABEL: Record<string, string> = { c: "C", go: "Go", rust: "Rust" };
  const NB_CMD: Record<string, string> = {
    decompile: "proj.analyses.Decompiler(...)",
    disasm: "proj.kb.functions[...].pp()",
    symexec: "simgr.explore(find=accepted)",
  };
  const GUI_CMD: Record<string, string> = {
    decompile: "Pseudocode view — decompiled with angr's own decompiler",
    disasm: "Disassembly view — control-flow graph",
    symexec: "Symbolic Execution view — explore to `accepted`",
  };
  const TYPE_MS = 1100; // how long typing one command takes, whatever its length
  const PAUSE_MS = 450; // beat between a typed command and its output
  const REVEAL_MS = 650; // let the card's fade-in finish before the first keystroke

  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  const mount = () => {
    const root = document.querySelector<HTMLElement>("[data-showcase]");
    if (!root || root.dataset.bound) return;
    root.dataset.bound = "1";

    const tiles = Array.from(root.querySelectorAll<HTMLElement>("[data-tile]"));
    const groups = Array.from(root.querySelectorAll<HTMLElement>("[data-axis]"));
    const title = root.querySelector<HTMLElement>("[data-title]");
    const cmd = root.querySelector<HTMLElement>("[data-cmd]");
    const stage = root.querySelector<HTMLElement>("[data-stage]");
    const [iface0, lang0, mode0] = (root.dataset.default || "cli|c|decompile").split("|");
    const sel: Record<string, string> = { iface: iface0, lang: lang0, mode: mode0 };

    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let run = 0; // bumps on every switch so a stale typing loop stops

    // The hero card scroll-reveals (Base.astro adds .in-view, then it fades in
    // over ~0.7s). Typing that starts before the card is visible is typing
    // nobody sees, so the first run waits for the reveal to land. Resolves
    // true if it actually had to wait.
    const wrap = root.closest<HTMLElement>(".reveal");
    const revealed = () =>
      new Promise<boolean>((resolve) => {
        if (!wrap || !document.documentElement.classList.contains("js") || wrap.classList.contains("in-view")) {
          resolve(false);
          return;
        }
        const mo = new MutationObserver(() => {
          if (wrap.classList.contains("in-view")) {
            mo.disconnect();
            resolve(true);
          }
        });
        mo.observe(wrap, { attributes: true, attributeFilter: ["class"] });
      });

    // Type each step's command, then reveal its output — a nod to "this is a
    // terminal" that costs about a second and never hides the finished result
    // for long. Re-selecting a tile replays it; switching away cancels it.
    const typeOut = async (tile: HTMLElement) => {
      const token = ++run;
      const steps = Array.from(tile.querySelectorAll<HTMLElement>("[data-step]"));
      const live = () => token === run;
      steps.forEach((st) => st.toggleAttribute("hidden", true));
      let first = true;
      for (const st of steps) {
        const typed = st.querySelector<HTMLElement>("[data-typed]")!;
        const out = st.querySelector<HTMLElement>("[data-out]")!;
        const text = typed.dataset.typed || "";
        typed.textContent = "";
        typed.classList.add("typing");
        out.toggleAttribute("hidden", true);
        st.toggleAttribute("hidden", false);
        if (first) {
          // an empty prompt with a blinking cursor while the card fades in
          if (await revealed()) await sleep(REVEAL_MS);
          if (!live()) return;
          first = false;
        }
        const delay = TYPE_MS / Math.max(text.length, 1);
        for (let i = 1; i <= text.length; i++) {
          await sleep(delay);
          if (!live()) return;
          typed.textContent = text.slice(0, i);
        }
        await sleep(PAUSE_MS);
        if (!live()) return;
        typed.classList.remove("typing");
        out.toggleAttribute("hidden", false);
      }
    };
    const showAll = (tile: HTMLElement) => {
      tile.querySelectorAll<HTMLElement>("[data-step]").forEach((st) => {
        st.toggleAttribute("hidden", false);
        const typed = st.querySelector<HTMLElement>("[data-typed]")!;
        typed.textContent = typed.dataset.typed || "";
        typed.classList.remove("typing");
        st.querySelector<HTMLElement>("[data-out]")!.toggleAttribute("hidden", false);
      });
    };

    const render = () => {
      const id = `${sel.iface}-${sel.lang}-${sel.mode}`;
      let current: HTMLElement | null = null;
      tiles.forEach((t) => {
        const on = t.dataset.tile === id;
        t.toggleAttribute("hidden", !on);
        if (on) current = t;
      });
      groups.forEach((g) => {
        const axis = g.dataset.axis!;
        g.querySelectorAll<HTMLButtonElement>("[role=radio]").forEach((b) => {
          const on = b.dataset.value === sel[axis];
          b.setAttribute("aria-checked", String(on));
          b.tabIndex = on ? 0 : -1;
        });
      });
      if (stage) stage.scrollTop = 0;
      if (title) title.textContent = `fauxware (${LANG_LABEL[sel.lang]}) — ${IFACE_TITLE[sel.iface]}`;
      if (cmd) {
        cmd.textContent =
          sel.iface === "cli"
            ? (current as HTMLElement | null)?.dataset.display || ""
            : sel.iface === "ipython"
              ? NB_CMD[sel.mode]
              : GUI_CMD[sel.mode];
      }
      run++; // cancel any typing still going on in a tile we just left
      if (current && sel.iface === "cli") {
        if (reduce) showAll(current);
        else typeOut(current);
      }
    };

    groups.forEach((g) => {
      const axis = g.dataset.axis!;
      const buttons = Array.from(g.querySelectorAll<HTMLButtonElement>("[role=radio]"));
      buttons.forEach((b, i) => {
        b.addEventListener("click", () => {
          sel[axis] = b.dataset.value!;
          render();
        });
        b.addEventListener("keydown", (e) => {
          if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
          e.preventDefault();
          const next = buttons[(i + (e.key === "ArrowRight" ? 1 : -1) + buttons.length) % buttons.length];
          sel[axis] = next.dataset.value!;
          render();
          next.focus();
        });
      });
    });

    render();
  };

  mount();
  document.addEventListener("astro:after-swap", mount);
</script>
